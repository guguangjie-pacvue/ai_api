    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "POST Performance 创建",
        "method": "POST",
        "base_url": "{{base_urls.WALMARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "Notification/Performance",
        "request_body": {
          "name": "test_perf_notif",
          "targetType": 0,
          "targetIds": [
            426321
          ],
          "isPaused": false,
          "isDeleted": false,
          "dataRange": {
            "index": 1,
            "length": 1,
            "attrWindow": 0
          },
          "requirementsList": [
            {
              "field": "Spend",
              "operand": 20,
              "value": "1"
            }
          ],
          "emailsJson": "autoui_acount@test.com"
        },
        "extract_vars": {
