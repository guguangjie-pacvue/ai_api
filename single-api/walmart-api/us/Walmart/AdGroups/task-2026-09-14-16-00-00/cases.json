    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建测试广告组 000test161701a",
        "method": "POST",
        "base_url": "{{base_urls.WALMARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups",
        "request_body": {
          "advertiserId": 16274451,
          "profileId": 16274451,
          "campaignId": 426321,
          "name": "000test161701a",
          "selectionType": "ITEMS"
        },
        "extract_vars": {
