        "path": "NegativeKeyword/bulk",
        "request_body": {
          "models": [
            {
              "keywordText": "test114358negkw",
              "profileId": "{{variables.profile_id_single}}",
              "adGroupId": "770991122",
              "campaignId": "426321",
              "negativeMatchType": "negativeExact",
              "state": "enabled"
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "data.successCount": 1,
          "data": {
            "$not_empty": true
          }
        }
      },
      {
        "name": "POST search 定位新建ID",
        "method": "POST",
        "base_url": "{{base_urls.WALMARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "NegativeKeyword/search",
        "request_body": {
          "adGroupIds": [
            770991122
          ],
          "adGroupStatus": [],
          "campaignIds": [],
          "campaignStatus": [],
          "tagIds": [],
          "campaignTagIds": [],
          "keywordMatchType": [],
          "profileIds": [
            "{{variables.profile_id_single}}"
          ],
          "filters": [],
          "negativeKeywordStatus": [],
          "tagCampaignLogic": 0,
          "pageInfo": {
            "PageSize": 20,
            "PageIndex": 1,
            "OrderBy": "createdAt desc"
          }
        },
        "extract_vars": {
          "new_nk_id": "data.list[0].keywordId"
        },
        "expected_response": {
          "code": 200,
          "data.list[0].keywordText": "test114358negkw",
          "data": {
            "$not_empty": true
          }
        }
      },
      {
        "name": "PUT NegativeKeyword 禁用",
        "method": "PUT",
        "base_url": "{{base_urls.WALMARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "NegativeKeyword",
        "request_body": {
          "negativeKeywordIds": [
            "{{new_nk_id}}"
          ],
          "status": 0
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "data": {
            "$not_empty": true
          }
        }
      }
    ]
