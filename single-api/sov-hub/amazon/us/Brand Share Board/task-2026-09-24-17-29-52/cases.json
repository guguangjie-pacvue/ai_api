    "steps": [
      {
        "name": "创建看板(仅自有品牌)",
        "method": "POST",
        "base_url": "{{base_urls.SOVHUBBASEURL}}",
        "headers": "{{headers}}",
        "path": "/api/sov/brand-share-board",
        "request_body": {
          "clientId": "{{variables.client_id}}",
          "userId": "{{variables.user_id}}",
          "boardName": "swagger-api-case-mine-only",
          "productLine": "AMAZON",
          "categoryIds": "[\"{{variables.category_id}}\"]",
          "sovMetrics": "[\"shareOfShelf\",\"organicSOV\",\"paidSOV\"]",
          "brands": "[{\"name\":\"Matrix\",\"isMyBrand\":true}]"
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true
        }
      },
      {
        "name": "查询看板列表定位新建看板ID",
        "method": "GET",
        "base_url": "{{base_urls.SOVHUBBASEURL}}",
        "headers": "{{headers}}",
        "path": "/api/sov/brand-share-board/list",
        "request_body": {},
        "extract_vars": {
          "board_id_mineonly": "data[boardName=swagger-api-case-mine-only].id"
        },
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
