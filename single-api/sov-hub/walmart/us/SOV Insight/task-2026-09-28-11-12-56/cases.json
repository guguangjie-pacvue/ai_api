            "{{variables.category_id}}"
          ],
          "dim": "YTD",
          "deviceMode": "Aggregated",
          "tagIntersect": 0,
          "weekStart": "Sunday",
          "useWeight": false,
          "splitMark": 0,
          "pageInfo": {
            "pageSize": 20,
            "pageIndex": 1,
            "orderBy": "shareOfShelf desc",
            "orderBySnakeCase": "share_of_shelf DESC"
          },
          "selectedBrands": [
            "{{variables.brand_name}}"
          ],
          "insight": false
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "$is_array": true
          }
        }
      }
