        "name": "ASIN维度洞察查询",
        "method": "POST",
        "base_url": "{{base_urls.SOVHUBBASEURL}}",
        "headers": "{{headers}}",
        "path": "/api/sov/insight/asin",
        "request_body": {
          "clientId": "{{variables.client_id}}",
          "userId": "{{variables.user_id}}",
          "productLine": "WALMART",
          "realProductLine": "walmart",
          "startDate": "2026-01-01",
          "endDate": "2026-06-30",
