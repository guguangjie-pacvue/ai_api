  {
    "name": "POST /api/OrderV2/BulkUpdateOrderBudgetCaps - 批量修改Order DailyCap(自建一次性测试Order,含后置归档)",
    "description": "单接口测试：POST /api/OrderV2/BulkUpdateOrderBudgetCaps。先用Order/CreateOrder创建一次性测试Order(本账号真实advertiser，小额预算+1天flight窗口)，再对其调用BulkUpdateOrderBudgetCaps将dailyCap改为15，最后用Order/BulkUpdateOrders将该Order置INACTIVE归档(避免残留、保证可重复执行)。已知本账号旧Order(576582423523984235)已结束超180天，更新类操作会被业务规则拒绝，故改为自建实体验证，规避此限制。业务成功断言：Data=\"Operation succeeded\"。11条随机样本中占比约100%(单Order批量场景为主流模式)。",
    "module": "OrderV2",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建一次性测试Order",
        "method": "POST",
        "base_url": "{{DSPBASEURL}}",
        "path": "Order/CreateOrder",
        "request_body": {
          "profileId": "{{profile_id_single}}",
          "advertiserId": "{{advertiser_id_single}}",
          "orderTemplateId": "",
          "order": {
            "advertiserId": "{{advertiser_id_single}}",
            "name": "test173732-budgetcaps",
            "externalId": "",
            "comments": "",
            "optimization": {
              "productLocation": "SOLD_ON_AMAZON",
              "goal": "CONSIDERATION",
              "goalKpi": "CLICK_THROUGH_RATE",
              "biddingStrategy": "SPEND_BUDGET_IN_FULL",
              "automateBudgetAllocation": true,
              "primaryInventoryTypes": [],
              "targetKpi": "10"
            },
            "budget": {
              "budgetCaps": [
                {
                  "recurrenceTimePeriod": "DAILY",
                  "amount": 10
                }
              ],
              "flights": [
                {
                  "amount": 10,
                  "startDateTime": "2026-09-23 12:00:00",
                  "endDateTime": "2026-09-24 12:00:00"
                }
              ]
            },
            "agencyFee": {
              "feePercentage": "12"
            },
            "frequencies": [
              {
                "frequencyType": "UNCAPPED"
              }
            ]
          },
          "customFees": null,
          "associatedConversions": [],
          "conversionTracking": {
            "products": {
              "productList": [],
              "productFile": null
            }
          }
        },
        "extract_vars": {
          "bc_order_id": "Data"
        },
        "expected_response": {
          "IsSuccessStatusCode": true
        }
      },
      {
        "name": "修改DailyCap为15",
        "method": "POST",
        "base_url": "{{DSPBASEURL}}",
        "path": "OrderV2/BulkUpdateOrderBudgetCaps",
        "request_body": [
          {
            "profileId": "{{profile_id_single}}",
            "advertiserId": "{{advertiser_id_single}}",
            "orderId": "{{bc_order_id}}",
            "dailyCap": 15
          }
        ],
        "extract_vars": {},
        "expected_response": {
          "IsSuccessStatusCode": true,
          "Data": "Operation succeeded"
        }
      },
      {
        "name": "后置归档-新建Order置INACTIVE",
        "method": "POST",
        "base_url": "{{DSPBASEURL}}",
        "path": "Order/BulkUpdateOrders",
