  {
    "name": "【仅生成不执行-高风险】POST /api/SuperWizard/DeleteWizardDraft - 删除向导草稿",
    "description": "单接口测试：POST /api/SuperWizard/DeleteWizardDraft。仅传wizardId即可删除该向导草稿。仅生成不执行原因：本接口的唯一草稿来源SaveSuperWizard（批量导入创建广告结构，含Products/Creatives/Structure/Budget多步骤且isRunAd可直接真实投放）在365天ES窗口内0流量，无法安全复现其真实入参去创建一条可丢弃的测试草稿；若改用ES样本中出现的真实wizardId执行删除，会误删共享沙盒账号里其他真实用户的草稿，不可逆且不可重建，故仅生成case（body结构取自ES真实样本）供人工评审，不执行、不提交run-cases.py。2条随机样本(总2条)中占比100%（2次），样本量很少，场景覆盖可能不全。",
    "module": "SuperWizard",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "调用 DeleteWizardDraft",
        "method": "POST",
        "base_url": "{{DSPBASEURL}}",
        "path": "SuperWizard/DeleteWizardDraft",
        "request_body": {
          "wizardId": "[NEEDS_REAL_VALUE]"
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true,
          "data": true
        }
      }
    ]
  }
