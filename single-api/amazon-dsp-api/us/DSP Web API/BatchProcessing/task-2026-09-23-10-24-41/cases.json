    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "调用 BulkModifyDataByExcelType",
        "method": "POST",
        "base_url": "{{DSPBASEURL}}",
        "path": "BatchProcessing/BulkModifyDataByExcelType",
        "request_body": {
          "OrderNames": [
            {
              "NewOrderNames": "test20260923_renamed_order",
              "ProfileId": null,
              "AdvertiserId": "{{advertiser_id_single}}",
              "AdvertiserName": "[NEEDS_REAL_VALUE-本账号真实AdvertiserName]",
              "OrderId": "{{order_id_active}}",
              "OrderName": "[NEEDS_REAL_VALUE-该Order当前真实名称,需先GET查询]",
              "ErrorMessage": null,
              "CurrencyCode": null,
              "CurrencySymbol": "$"
            }
          ],
          "FileName": "test20260923_orders.xlsx",
          "IsSuccess": true,
          "Status": "Completed",
          "TemplateName": "Order settings  - Name"
