[
  {
    "name": "POST /api/Adgroup/v3/UpdateAdgroupByExcel - 批量修改AdGroup名称(含读原值+还原,可重复)",
    "description": "单接口测试：POST /api/Adgroup/v3/UpdateAdgroupByExcel。真实用户场景：通过Excel批量导入方式修改AdGroup信息，数组元素仅携带Name字段(State/Bid未传，说明该次操作只改名)。ES样本总数仅1条(sample_count=1，未达3条下限，按实际条数生成1个case)。写操作前先用GetAdGroupEditData读取{{adgroup_id}}当前name作为{{original_name}}；主操作用ES真实样本出现过的名称值批量改名；最后用同接口把名称改回读到的原值，保证成对可重复执行、不留残留脏数据。ProfileId/CampaignId/AdgroupId已替换为测试账号sponsoredProducts通用测试实体({{profile_id}}/{{exist_sp_campaign_id}}/{{adgroup_id}})，未直接使用ES日志中其他真实客户的实体ID。",
    "module": "Adgroup",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "读取AdGroup当前编辑数据(记录原名称)",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Adgroup/v3/GetAdGroupEditData",
        "request_body": {
          "profileId": "{{profile_id}}",
          "campaignId": "{{exist_sp_campaign_id}}",
          "adGroupId": "{{adgroup_id}}"
        },
        "extract_vars": {
          "original_name": "data.name"
        },
        "expected_response": {
          "code": 200,
          "success": true,
          "data.name": {
            "$not_empty": true
          }
        }
      },
      {
        "name": "通过Excel批量导入修改AdGroup名称",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Adgroup/v3/UpdateAdgroupByExcel",
        "request_body": [
          {
            "ProfileId": "{{profile_id}}",
            "CampaignId": "{{exist_sp_campaign_id}}",
            "AdgroupId": "{{adgroup_id}}",
            "Name": "Classic Hiking Crew Socks (3 Pack) - Generic Broad"
          }
        ],
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true
        }
      },
      {
        "name": "后置还原-把AdGroup名称改回原值",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Adgroup/v3/UpdateAdgroupByExcel",
        "request_body": [
          {
            "ProfileId": "{{profile_id}}",
            "CampaignId": "{{exist_sp_campaign_id}}",
            "AdgroupId": "{{adgroup_id}}",
            "Name": "{{original_name}}"
          }
        ],
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true
        }
      }
    ]
