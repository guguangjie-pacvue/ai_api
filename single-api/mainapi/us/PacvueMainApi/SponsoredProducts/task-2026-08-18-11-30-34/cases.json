[
  {
    "name": "POST /api/SponsoredProducts/CreateCampaign - 创建SP手动投放Campaign(含后置归档,可重复)",
    "description": "单接口测试：POST /api/SponsoredProducts/CreateCampaign 创建一次性SP手动投放Campaign(paused状态,不产生真实曝光/花费) + PUT Campaign/V4/Update 后置归档清理,保证用例可重复执行,不污染共享测试数据。500条随机样本中占比约100.0%（500次）。",
    "module": "SponsoredProducts",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建SP Campaign",
        "method": "POST",
        "base_url": "{{base_urls.BASEURL}}",
        "headers": "{{headers}}",
        "path": "SponsoredProducts/CreateCampaign",
        "request_body": {
          "ProfileId": "{{variables.profile_id}}",
          "TargetingType": "MANUAL",
          "Name": "TC-SponsoredProducts-CreateCampaign-AutoTest",
          "DailyBudget": "10",
          "State": "ENABLED",
          "StartDate": "{{variables.date_start_mdy}}",
          "EndDate": "",
          "BidStrategy": "legacyForSales",
          "AdGroup": {
            "ProfileId": "{{variables.profile_id}}",
            "Name": "TC-SP-CreateCampaign-AG",
            "DefaultBid": "0.5",
            "State": "ENABLED"
          },
          "Ads": [
            {
              "State": "ENABLED",
              "ProductType": "ASIN",
              "Product": "{{variables.target_asin}}"
            }
          ]
        },
        "extract_vars": {
          "created_campaign_id": "data.CampaignId"
        },
        "expected_response": {
          "code": 200,
          "success": true
        }
      },
      {
        "name": "后置清理-归档新建的Campaign",
        "method": "PUT",
        "base_url": "{{base_urls.BASEURL}}",
        "headers": "{{headers}}",
        "path": "Campaign/V4/Update",
        "request_body": {
          "profileIds": [
            "{{variables.profile_id}}"
          ],
          "campaigns": [
            {
              "campaignId": "{{created_campaign_id}}",
              "profileId": "{{variables.profile_id}}",
              "state": "archived",
              "campaignType": "sponsoredProducts"
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "successCount": {
              "$gte": 1
            }
          }
        }
      }
    ]
  },
