          "campaignId": "{{created_sb_campaign_id}}",
          "isAutoCollection": false,
          "collectionAds": [
            {
              "adGroupId": "{{created_sb_adgroup_id}}",
              "creative": {
                "asins": [
                  "{{target_asin}}",
                  "B00K6B1Z9S",
                  "B000MXB3JW"
                ],
                "brandLogoAssetID": "amzn1.assetlibrary.asset1.90f3478ac1da00907d4ca12702b25595",
                "brandLogoCrop": {
                  "top": 0,
                  "left": 0,
                  "width": 400,
                  "height": 400
                },
                "brandName": "AutoCaseTestBrand",
                "landingPage": {
                  "asins": [
                    "{{target_asin}}",
                    "B00K6B1Z9S",
                    "B000MXB3JW"
                  ],
                  "pageType": "PRODUCT_LIST"
                }
              },
              "name": "autocase_collection_ad_manual",
              "state": "ENABLED"
            }
          ]
