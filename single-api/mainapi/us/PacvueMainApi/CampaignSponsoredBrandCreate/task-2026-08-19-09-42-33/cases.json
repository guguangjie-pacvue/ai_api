        "request_body": {
          "ProfileId": "{{profile_id}}",
          "Name": "autocase_precreate_for_collection",
          "State": "PAUSED",
          "DailyBudget": "10",
          "BudgetType": "daily",
          "StartDate": "{{date_start}}",
          "SalesChannel": "AMAZON",
          "CostType": "CPC",
          "Goal": "CLICKS",
          "AdGroup": {
            "Name": "autocase_precreate_ag",
            "State": "ENABLED",
            "ProfileId": "{{profile_id}}"
          },
          "Ads": []
        },
        "extract_vars": {
          "created_sb_campaign_id": "data.CampaignId",
          "created_sb_adgroup_id": "data.AdGroupId"
        },
        "expected_response": {
          "code": 200,
          "success": true
        }
      },
      {
        "name": "创建手动ProductCollection(Manual Collection)广告",
        "method": "POST",
