[
  {
    "name": "【高风险-仅生成不执行】POST /api/SponsoredDisplay/Campaign/Create - 创建SD广告系列+广告组+广告(含后置归档,可重复)",
    "description": "单接口测试：POST /api/SponsoredDisplay/Campaign/Create。一次性创建SD广告系列、默认广告组、商品广告及相似商品views定向。365天内约382次真实调用，字段结构参照ES真实样本，按Swagger类型改用测试账号自身profile_id/asin构造。涉及真实创建广告系列(带DailyBudget)，仅生成case供人工评估，不自动执行；如需执行须人工确认预算后手动运行，并对新建campaign执行归档清理。",
    "module": "SponsoredDisplayMaterial",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "【高风险-仅生成不执行】创建SD Campaign",
        "method": "POST",
        "base_url": "{{base_urls.BASEURL}}",
        "headers": "{{headers}}",
        "path": "SponsoredDisplay/Campaign/Create",
        "request_body": {
          "IsCreatedAsinLandPage": false,
          "ProfileId": "{{variables.profile_id}}",
          "StartDate": "{{variables.today}}",
          "PortfolioId": "{{variables.test_portfolio_id}}",
          "State": "enabled",
          "Name": "autoTest_SD_Campaign_{{variables.today}}",
          "DailyBudget": 10,
          "CostType": "VCPM",
          "CampaignTagIds": [],
          "AdGroup": {
            "ProfileId": "{{variables.profile_id}}",
            "Name": "autoTest_SD_adg_{{variables.today}}",
            "DefaultBid": 1,
            "State": "enabled",
            "BidOptimization": "reach",
            "CreativeType": "IMAGE",
            "CostControlEnabled": false
          },
          "Ads": [
            {
              "ProfileId": "{{variables.profile_id}}",
              "State": "enabled",
              "ResponsiveEcommerceSettings": {
                "Products": [
                  {
                    "ProductId": "{{variables.target_asin}}",
                    "ProductIdType": "ASIN"
                  }
                ]
              }
            }
          ],
          "TargetingClause": [
            {
              "expressionType": "manual",
              "expression": [
                {
                  "type": "similarProduct"
                }
              ],
              "type": "views",
              "bid": 1,
              "state": "enabled"
            }
          ]
        },
        "extract_vars": {
          "created_sdm_campaign_id": "data.CampaignId"
        },
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "$not_empty": true
          }
        }
      },
      {
        "name": "后置清理-归档新建Campaign",
        "method": "POST",
        "base_url": "{{base_urls.BASEURL}}",
        "headers": "{{headers}}",
        "path": "CampaignUpdate/V3/UpdateCampaignsStatus",
        "request_body": {
          "param": [
            {
              "profileId": "{{variables.profile_id}}",
              "campaignId": "{{created_sdm_campaign_id}}"
            }
          ],
          "state": "archived"
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true
        }
      }
    ]
  },
