    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "调用 GetSearchAssets",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "CreativeHub/GetSearchAssets",
        "request_body": {
          "profileId": "{{creativehub_sd_profile_id}}",
          "requset": {
            "filterCriteria": {
              "valueFilters": [
                {
                  "valueField": "ASSET_TYPE",
                  "values": [
                    "IMAGE"
                  ]
                },
                {
                  "valueField": "ASSET_EXTENSION",
                  "values": [
                    "PNG",
                    "JPG",
                    "JPEG"
