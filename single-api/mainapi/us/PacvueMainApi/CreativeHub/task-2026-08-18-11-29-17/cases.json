    "name": "POST /api/CreativeHub/GetSearchAssets - 场景1_按ASSET_TYPE+扩展名筛选素材库并按创建时间倒序分页",
    "description": "单接口测试：POST /api/CreativeHub/GetSearchAssets。用户在素材库中按 ASSET_TYPE=IMAGE、扩展名 PNG/JPG/JPEG 过滤，并按创建时间倒序分页查询（size=100）。US环境。500条随机样本中占比100%(100条)。",
    "module": "CreativeHub",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "调用 GetSearchAssets",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "CreativeHub/GetSearchAssets",
        "request_body": {
          "profileId": "{{profile_id}}",
          "requset": {
            "text": null,
            "filterCriteria": {
              "valueFilters": [
                {
                  "valueField": "ASSET_TYPE",
                  "values": [
                    "IMAGE"
                  ]
                },
                {
                  "valueField": "ASSET_EXTENSION",
                  "values": [
                    "PNG",
                    "JPG",
                    "JPEG"
                  ]
                }
              ]
            },
            "sortCriteria": {
              "field": "CREATED_TIME",
              "order": "DESC"
            },
            "pageCriteria": {
              "identifier": {
                "pageNumber": 1,
                "token": null
              },
              "size": 100
            }
          }
        },
