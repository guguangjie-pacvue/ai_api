[
  {
    "name": "POST /api/AdExtension/BulkCreate - 批量创建ENABLED状态PROMPTS广告扩展(含后置清理)",
    "description": "单接口测试：POST /api/AdExtension/BulkCreate。真实用户场景：批量为sponsoredProducts广告组创建State=ENABLED、AdExtensionType=PROMPTS、AdExtensionStatus=OPTED_OUT的AI Prompt广告扩展。500条随机样本中占比约94.1%(305/324条item)，是最主流的写入场景。第2步后置操作将新建扩展的State改为PAUSED作为清理，保证用例可重复执行。ProfileId/AdGroupId已替换为测试账号真实可用组合(ES原始样本使用的是其他真实客户ID，不可直接执行；测试账号下sp_manual_pat_adgroup_id对该接口返回Invalid adGroup id，已改用ad_adgroup_id)。",
    "module": "AdExtension",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "批量创建PROMPTS广告扩展(ENABLED)",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "AdExtension/BulkCreate",
        "request_body": [
          {
            "UserId": "{{user_id}}",
            "ProfileId": "{{profile_id}}",
            "CampaignType": "sponsoredProducts",
            "AdExtensionType": "PROMPTS",
            "State": "ENABLED",
            "MarketplaceScope": "SINGLE_MARKETPLACE",
            "Marketplace": "US",
            "AdGroupId": "{{ad_adgroup_id}}",
            "AdExtensionStatus": "OPTED_OUT",
            "PromptText": "Dog treats made in USA facilities"
          }
        ],
        "extract_vars": {
          "created_ad_extension_id": "data.result[0].APIResult[0].entityId"
        },
        "expected_response": {
          "code": 200,
          "success": true,
          "data.successCount": {
            "$not_empty": true
          }
        }
      },
      {
        "name": "后置清理-将新建扩展状态改为PAUSED",
        "method": "PUT",
        "base_url": "{{BASEURL}}",
        "path": "AdExtension/BulkUpdate",
        "request_body": {
          "UserId": "{{user_id}}",
          "Items": [
            {
              "UserId": "{{user_id}}",
              "ProfileId": "{{profile_id}}",
              "CampaignType": "sponsoredProducts",
              "AdExtensionId": "{{created_ad_extension_id}}",
              "State": "PAUSED",
              "OldState": "ENABLED",
              "Marketplace": "US"
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true
        }
      }
    ]
  },
