  {
    "name": "GET /api/DownloadCenter/v3/DownloadFile - 下载已完成任务文件(链式取id)",
    "description": "单接口测试：GET /api/DownloadCenter/v3/DownloadFile。先调 List 取第一条下载任务的 Id/FileName，再下载该文件（GET id+fileName）。ES 无流量记录；依赖测试账号存在已完成下载任务，若 List 为空则第2步无法取到 id。返回文件流（非 JSON 信封），仅校验 HTTP 200。",
    "module": "DownloadCenter",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "调用 List 取下载任务",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "/DownloadCenter/v3/List",
        "request_body": {
          "PageInfo": {
            "PageSize": 20,
            "PageIndex": 1,
            "OrderByField": "CreateTimeUTC",
            "OrderAsc": false
          }
        },
        "extract_vars": {
          "download_file_id": "data.Data[0].Id",
          "download_file_name": "data.Data[0].FileName"
        },
        "expected_response": {
          "code": 200,
          "success": true
        }
      },
      {
        "name": "调用 DownloadFile",
        "method": "GET",
        "base_url": "{{BASEURL}}",
        "path": "/DownloadCenter/v3/DownloadFile",
        "request_body": {
          "id": "{{download_file_id}}",
          "fileName": "{{download_file_name}}"
        },
        "extract_vars": {},
        "expected_response": {
          "status_code": 200
        }
      }
    ]
  },
  {
    "name": "POST /api/DownloadCenter/v3/DownloadCampaignPageData - 导出Campaign报表(单日Dim=date)",
    "description": "单接口测试：POST /api/DownloadCenter/v3/DownloadCampaignPageData。功能验证：导出 Campaign 报表，Dim=date 按日、单 Profile、单日范围({{date_end_mdy}})、最小指标列。DownloadCenter 路由 ES 零流量，入参取自同 DTO(CampaignPerfInput)的真实生产样本（真实调用走 /api/Campaign/v3/DownloadCampaignPageData，占比100%(37357次)），profileId 与日期已变量化。返回 ApiResponseBase<String>。已知限制：测试超管账号 profile 数据量过大，即便单日/2列/无过滤，后端同步导出仍触发 SQL『expression services limit』/执行超时(业务code 513)，属测试账号数据规模的后端限制，非接口契约缺陷。",
    "module": "DownloadCenter",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "调用 DownloadCampaignPageData",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "/DownloadCenter/v3/DownloadCampaignPageData",
        "request_body": {
          "Dim": "date",
          "IsFead": 0,
          "ProfileIds": [
            "{{profile_id}}"
          ],
          "ToMarket": "US",
          "MetricIds": [],
          "Filters": [
            {
              "filterFieldName": "ReportDateTime",
              "filterContent": "{\"type\":1,\"FilterBetween\":{\"start\":\"{{date_end_mdy}}\",\"end\":\"{{date_end_mdy}}\"}}"
            }
          ],
          "OutPutFields": [
            "CampaignName",
            "Spend"
          ],
          "IsShowNTB": 0,
          "PageInfo": {
            "orderByFields": [
              {
                "orderByField": "Spend",
                "orderAsc": false
              }
            ],
            "orderAsc": false,
            "pageSize": 100,
            "pageIndex": 1,
            "IsJustOrderby": false
          }
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true
        }
      }
    ]
  }
]