              "MatchType": ["PT"],
              "TargetingType": "manual-PAT"
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "successCount": { "$gte": 1 }
          }
        }
      },
      {
        "name": "定位新建映射的真实Id",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "CampaignMapping/V3/GetCampaignMapping",
        "request_body": {
          "SourceProfileId": ["{{profile_id}}"],
          "SourceCampaignId": ["{{sp_manual_pat_campaign_id}}"],
          "SourceAdgroupId": ["{{sp_manual_pat_adgroup_id}}"],
          "toMarket": "US",
          "pageInfo": {
            "pageIndex": 1,
            "pageSize": 50,
            "orderAsc": false,
            "orderByField": "id"
          }
