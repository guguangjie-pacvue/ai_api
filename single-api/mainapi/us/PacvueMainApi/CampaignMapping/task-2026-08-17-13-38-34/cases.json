    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建CampaignMapping(SP->SD)",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "CampaignMapping/V3/UpsertCampaignMapping",
        "request_body": {
          "SourceProfileId": "{{profile_id}}",
          "SourceCampaignId": "{{sp_manual_pat_campaign_id}}",
          "SourceAdgroupId": "{{sp_manual_pat_adgroup_id}}",
