  {
    "name": "POST /api/Targeting/V3/CreateSDPAT - 场景1_SD广告组新增ASIN商品定向PAT(含后置清理,可重复)",
    "description": "单接口测试：POST /api/Targeting/V3/CreateSDPAT。向测试账号SD手动广告组(campaigntestSD Assert-02)新增一个商品定向PAT(asinSameAs B0CG88XKV6)。type为空串表示SD商品上下文定向，expressionType=manual，state=enabled，bid=0.2需小于campaign日预算($1.00)的一半。断言successCount>=1。第2步后置操作用UpdateTargetPATStatus将新建target归档(Amazon实体仅支持archive)，保证用例可重复执行——归档后同ASIN可再次创建。基于ES 63条真实样本结构。500条随机样本中占比约100.0%（63次）。",
    "module": "Targeting",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建 SD 商品定向 PAT",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Targeting/V3/CreateSDPAT",
        "request_body": {
          "targetingClause": [
            {
              "adGroupId": "{{sd_adgroup_id}}",
              "expression": [
                {
                  "type": "asinSameAs",
                  "value": "B0CG88XKV6"
                }
              ],
              "type": "",
              "bid": "0.2",
              "expressionType": "manual",
              "state": "enabled"
            }
          ],
          "adGroupsAndCampaigns": [
            {
              "profileId": "{{profile_id}}",
              "campaignId": "{{sd_campaign_id}}",
              "adGroupId": "{{sd_adgroup_id}}"
            }
          ]
        },
        "extract_vars": {
          "created_target_id": "data.result[0].APIResult[0].entityId"
        },
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "successCount": {
              "$gte": 1
            }
          }
        }
      },
      {
        "name": "后置清理-归档新建target",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Targeting/V3/UpdateTargetPATStatus",
        "request_body": {
          "Item": [
            {
              "ProfileId": "{{profile_id}}",
              "CampaignId": "{{sd_campaign_id}}",
              "AdgroupId": "{{sd_adgroup_id}}",
              "TargetId": "{{created_target_id}}",
              "CampaignType": "SponsoredDisplay",
              "MatchType": ""
            }
          ],
          "state": "archived"
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "successCount": {
              "$gte": 1
            }
          }
        }
      }
    ]
  }
