  {
    "name": "POST /api/Notification/V3/AddEmailNotification - 邮件通知规则生命周期(创建+查+改+暂停+删除)",
    "description": "单接口测试：POST /api/Notification/V3/AddEmailNotification。串联该Notification子体系5个真实接口：1)创建按Spend条件的邮件通知规则 2)按列表定位真实Id(创建响应不返回Id) 3)修改规则名称 4)暂停规则(ChangeStatus) 5)删除规则作为清理。AddEmailNotification全量历史仅4条真实样本，字段结构取自真实样本。",
    "module": "Notification",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建邮件通知规则",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Notification/V3/AddEmailNotification",
        "request_body": {
          "Name": "TC-AutoTest-EmailNotif",
          "AdvertiserIds": [],
          "ProfileIds": ["{{profile_id}}"],
          "Conditions": [
            { "DataTypeStr": "Spend", "Index": 1, "Length": 1, "OPStr": "Greater", "Value": "1", "Unit": "$", "OP": "Greater", "DataType": "Spend" }
          ],
          "Emails": ["test@example.com"],
          "DataAppliedIn": 0,
          "CampaignTagId": []
        },
        "extract_vars": {},
        "expected_response": { "code": 200, "success": true }
      },
      {
        "name": "定位新建规则的真实Id",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Notification/V3/GetEmailNotificationList",
        "request_body": { "index": 0, "length": 5, "dataAppliedIn": [] },
        "extract_vars": { "created_notif_id": "data.data[0].Id" },
        "expected_response": { "code": 200, "success": true, "data.data": { "$is_array": true } }
      },
      {
        "name": "修改规则名称",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Notification/V3/UpdateEmailNotification",
        "request_body": {
          "id": "{{created_notif_id}}",
          "Name": "TC-AutoTest-EmailNotif-Updated",
          "AdvertiserIds": [],
          "ProfileIds": ["{{profile_id}}"],
          "Conditions": [
            { "DataTypeStr": "Spend", "Index": 1, "Length": 1, "OPStr": "Greater", "Value": "1", "Unit": "$", "OP": "Greater", "DataType": "Spend" }
          ],
          "Emails": ["test@example.com"],
          "DataAppliedIn": 0,
          "CampaignTagId": []
        },
        "extract_vars": {},
        "expected_response": { "code": 200, "success": true }
      },
      {
        "name": "暂停规则",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Notification/V3/ChangeStatus",
        "request_body": { "id": "{{created_notif_id}}", "isPaused": true },
        "extract_vars": {},
        "expected_response": { "code": 200, "success": true }
      },
      {
        "name": "后置清理-删除规则",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Notification/V3/DeleteEmailNotification",
        "request_body": { "id": "{{created_notif_id}}" },
        "extract_vars": {},
        "expected_response": { "code": 200, "success": true }
      }
    ]
  },
