  {
    "name": "POST /api/Ad/v3/BulkUpdateAds - 场景1_批量改广告名(可逆,占比100%)",
    "description": "单接口测试：POST /api/Ad/v3/BulkUpdateAds。批量更新广告名(50/50样本均为改Name,占比约100%)。US环境。写操作：步骤1改名为测试名，步骤2还原原名(12341234)，可重复执行不留残留。断言业务成功计数 data.result[0].Success>=1。",
    "module": "Ad",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "改广告名为测试名",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Ad/v3/BulkUpdateAds",
        "request_body": {
          "Inputs": [
            {
              "profileId": "{{profile_id}}",
              "AdId": "{{ad_id}}",
              "Name": "12341234_apitest"
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200,
          "success": true,
          "data": {
            "message": {
              "$contains": "Success:1"
            }
          }
        }
      },
      {
        "name": "后置还原-改回原广告名",
        "method": "POST",
        "base_url": "{{BASEURL}}",
        "path": "Ad/v3/BulkUpdateAds",
        "request_body": {
          "Inputs": [
            {
              "profileId": "{{profile_id}}",
              "AdId": "{{ad_id}}",
