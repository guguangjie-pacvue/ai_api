          "SalesChannel": "AMAZON",
          "CostType": "CPC",
          "Goal": "CLICKS",
          "SmartDefault": [
            "MANUAL"
          ],
          "AdGroup": {
            "Name": "autocase_ag_pc_create",
            "State": "ENABLED",
            "ProfileId": "{{profile_id}}"
          },
          "Ads": [
            {
              "Name": "autocase_ad_pc_create",
              "State": "ENABLED",
              "ProfileId": "{{profile_id}}",
              "ProductCollectionSettings": {
                "Brand": "TestBrand",
                "Headlines": [
                  "Test product collection headline"
                ],
                "Products": [
                  {
                    "ProductId": "B07XVWZQ8N",
                    "ProductIdType": "ASIN"
                  }
                ],
                "LandingPage": {
                  "LandingPageType": "STORE",
                  "LandingPageUrl": "https://www.amazon.com/stores/page/2E6C613B-6B23-4793-8F00-16F79B5EB110"
                },
                "BrandLogos": [],
                "CustomImages": []
              }
            }
          ],
          "Keywords": [
            {
              "keywordText": "organic coffee",
              "matchType": "exact",
              "bid": 1
            },
            {
              "keywordText": "coffee beans",
              "matchType": "phrase",
              "bid": 1
            }
          ]
        },
        "extract_vars": {
          "created_sb_campaign_id": "data.CampaignId"
        },
        "expected_response": {
          "code": 200,
          "success": true
        }
      },
      {
        "name": "后置清理-归档新建SB ProductCollection活动",
        "method": "PUT",
        "base_url": "{{BASEURL}}",
        "path": "/Campaign/v4/Update",
        "request_body": {
          "campaigns": [
            {
              "campaignType": "headlineSearch",
              "campaignId": "{{created_sb_campaign_id}}",
              "profileId": "{{profile_id}}",
