        "base_url": "{{BASEURL}}",
        "path": "/PortfolioFromAmz/v3/AddCampaigns",
        "request_body": {
          "addCampaigns": [
            {
              "ProfileID": "{{profile_id}}",
              "CampaignID": "{{exist_sb_campaign_id}}",
