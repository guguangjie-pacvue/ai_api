    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "开启预算通知",
        "method": "POST",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
