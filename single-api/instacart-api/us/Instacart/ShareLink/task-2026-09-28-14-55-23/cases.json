  {
    "name": "POST /api/ShareLink/shareLink - 创建分享链接(自建测试数据)+连带测试改日期范围/清理删除",
    "description": "写操作：为自己profile创建新分享链接，验证成功后PATCH改日期范围(dateRange 10->30)，最后DELETE BulkDelete清理删除。用户2026-09-28拍板执行。已用curl手工验证过一遍完整链路成功(id=409)。BulkDelete请求体是裸数组[id]不是{ids:[id]}，实测发现的坑。",
    "module": "ShareLink",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建分享链接",
        "method": "POST",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "ShareLink/shareLink",
        "request_body": {
          "isCrateEveryProfile": false,
          "profileIds": [
            "{{variables.profile_id}}"
          ],
          "keywordTagIds": [],
          "productTagIds": [],
          "dateRange": 10,
          "widgets": [
            {
              "id": 1005,
              "isCheck": true,
              "name": "Performance",
              "showOrder": 0,
              "thumbnail": "",
              "title": "Performance",
              "type": "Performance"
            }
          ],
          "ids": [
            0
          ],
          "categoryIds": [],
          "isNew": true,
          "campaignTagIds": []
        },
        "extract_vars": {
          "new_sharelink_id": "data.result[0].id"
        },
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "改日期范围",
        "method": "PATCH",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "ShareLink/UpdateShareLinkDateRange",
        "request_body": {
          "dateRange": 30,
          "ids": [
            "{{new_sharelink_id}}"
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "清理：删除分享链接",
        "method": "DELETE",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "ShareLink/BulkDelete",
        "request_body": [
          "{{new_sharelink_id}}"
        ],
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      }
