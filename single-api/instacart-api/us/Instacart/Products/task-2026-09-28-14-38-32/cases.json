        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "Products/status/byConditions",
        "request_body": {
          "enabled": false,
          "excludedIds": [],
          "conditions": {
            "start": "{{variables.date_start}}",
            "end": "{{variables.date_end}}",
            "bidFilters": null,
            "dim": "ytd",
            "profileIds": [
              "{{variables.profile_id}}"
            ],
            "multiSortList": [],
