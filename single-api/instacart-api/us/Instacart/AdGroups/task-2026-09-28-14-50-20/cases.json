  {
    "name": "POST /api/AdGroups - 创建广告组(自建测试数据)+连带测试改现有广告组出价/状态(改回原值)+新建广告组暂停",
    "description": "写操作：在测试campaign下创建新广告组(test161814_adgroup)，创建后立即PATCH status暂停(无广告组删除接口，暂停是可用的最小影响清理方式)；另外PATCH bid对已有测试adgroup改出价后改回原值(0.7)、PATCH status先启用(0)再改回暂停(1)恢复原始状态——2026-09-28收尾复核时经ES历史快照确认该广告组原始状态是paused(枚举0=enabled/1=paused，最初误判为0是原值，已通过真实API改回paused)。用户2026-09-28拍板执行。",
    "module": "AdGroups",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建新广告组",
        "method": "POST",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups",
        "request_body": {
          "profileId": "{{variables.profile_id}}",
          "campaignId": "{{variables.campaign_id}}",
          "name": "test161814_adgroup",
          "defaultBid": 0.3
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "查找新广告组的id",
        "method": "POST",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups/byCampaignIds",
        "request_body": {
          "profileIds": [
            "{{variables.profile_id}}"
          ],
          "campaignIds": [
            "{{variables.campaign_id}}"
          ],
          "statuses": [],
          "includeDsp": true
        },
        "extract_vars": {
          "new_adgroup_id": "data[name=test161814_adgroup].adGroupId"
        },
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "暂停新广告组(无删除接口，暂停作为清理)",
        "method": "PATCH",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups/status",
        "request_body": {
          "adGroupIds": [
            "{{new_adgroup_id}}"
          ],
          "status": 1
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "改已有测试广告组出价",
        "method": "PATCH",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups/bid",
        "request_body": {
          "ids": [
            "{{variables.adgroup_id}}"
          ],
          "setBidType": 0,
          "targetBid": 0.7
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "启用已有广告组(原始状态paused, 0=enabled)",
        "method": "PATCH",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups/status",
        "request_body": {
          "adGroupIds": [
            "{{variables.adgroup_id}}"
          ],
          "status": 0
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "改回暂停(1=paused, 恢复原始状态)",
        "method": "PATCH",
        "base_url": "{{base_urls.INSTACARTBASEURL}}",
        "headers": "{{headers}}",
        "path": "AdGroups/status",
        "request_body": {
          "adGroupIds": [
            "{{variables.adgroup_id}}"
          ],
          "status": 1
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      }
    ]
  }
