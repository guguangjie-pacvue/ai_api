{
  "mainapi": {
    "github_repo": "pacvue/mainapi",
    "swaggers": [
      {
        "title": "Amazon.Advertising.Api",
        "url": "https://api.pacvue.com/amazon-advertising-api/swagger/v1/swagger.json"
      },
      {
        "title": "PacvueMainApi",
        "url": "http://ec2-52-41-185-202.us-west-2.compute.amazonaws.com:30061/swagger/v1/swagger.json"
      }
    ],
    "es_index": {
      "us": "amazon-access-*",
      "cn": "cn-amazon-access-*",
      "eu": "eu-amazon-access-*"
    },
    "config": "single-api/mainapi/{env}/config.json"
  },
  "rule-api": {
    "github_repo": "pacvue/rule-api",
    "swaggers": [
      {
        "title": "RuleApi",
        "url": "https://api.pacvue.com/rule-api/v3/api-docs"
      }
    ],
    "platforms": ["amazon", "tiktok", "walmart","instacart","criteo","target","kroger","chewy","citrus","doordash","samsclub","bol","mercado","ebay"],
    "es_index": {
      "us": "rule-api-access-*"
    },
    "config": "single-api/rule-api/{platform}/{env}/config.json"
  }
}
