  {
    "name": "模板生命周期(创建/编辑/收藏/移动/删除) - amazon",
    "description": "单接口测试：串联 POST /template(创建) → POST /template/getTemplate(查询新建ID，创建接口本身不返回ID) → POST /template/editTemplate → POST /template/addFavorite → POST /template/moveTemplate → DELETE /template/{templateId}。创建一个临时测试模板，验证编辑/收藏/移动后，后置步骤删除，保证用例可重复执行。请求体结构取自ES真实样本。使用测试账号真实分类({{fixture_category_id}}/{{fixture_category_id_2}})。",
    "module": "template-controller",
    "granularity": "API",
    "since": "init",
    "last_modified": "init",
    "change_type": "NEW",
    "generated_by": "swagger-api-case",
    "steps": [
      {
        "name": "创建模板",
        "method": "POST",
        "base_url": "{{RULEBASEURL}}",
        "path": "/template",
        "request_body": {
          "templateName": "autotest_lifecycle_template",
          "description": "自动化测试用临时模板，用例结束后会被删除",
          "categoryId": "{{fixture_category_id}}",
          "ruleType": "Targeting",
          "isFavorite": false,
          "defaultTemplate": false,
          "frequency": "Weekly",
          "dayOfWeek": 7,
          "hour": 0,
          "automation": [
            {
              "requirements": [
                [
                  {
                    "field": "ROAS",
                    "valueType": "Custom",
                    "id": "requirement_0_0_autotest",
                    "value": "4",
                    "operand": "Greater"
                  }
                ]
              ],
              "dateIndex": {
                "length": 7,
                "index": 1,
                "days": 14
              },
              "action": {
                "cap": 10,
                "percentage": 10,
                "action": "Increase",
                "budgetRate": 100,
                "actionName": "Increase"
              },
              "secondDateIndex": {}
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "查询新建模板的ID",
        "method": "POST",
        "base_url": "{{RULEBASEURL}}",
        "path": "/template/getTemplate",
        "request_body": {
          "creator": [],
          "onlyFavorite": false,
          "defaultCategory": false,
          "ruleType": []
        },
        "extract_vars": {
          "created_template_id": "data[templateName=autotest_lifecycle_template].id"
        },
        "expected_response": {
          "code": 200,
          "data": {
            "$not_empty": true
          }
        }
      },
      {
        "name": "编辑模板",
        "method": "POST",
        "base_url": "{{RULEBASEURL}}",
        "path": "/template/editTemplate",
        "request_body": {
          "templateId": "{{created_template_id}}",
          "templateName": "autotest_lifecycle_template_edited",
          "description": "自动化测试用临时模板(已编辑)",
          "categoryId": "{{fixture_category_id}}",
          "ruleType": "Targeting",
          "isFavorite": false,
          "defaultTemplate": false,
          "frequency": "Weekly",
          "dayOfWeek": 7,
          "hour": 0,
          "automation": [
            {
              "requirements": [
                [
                  {
                    "field": "ROAS",
                    "valueType": "Custom",
                    "id": "requirement_0_0_autotest",
                    "value": "5",
                    "operand": "Greater"
                  }
                ]
              ],
              "dateIndex": {
                "length": 7,
                "index": 1,
                "days": 14
              },
              "action": {
                "cap": 12,
                "percentage": 12,
                "action": "Increase",
                "budgetRate": 100,
                "actionName": "Increase"
              },
              "secondDateIndex": {}
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "收藏模板",
        "method": "POST",
        "base_url": "{{RULEBASEURL}}",
        "path": "/template/addFavorite",
        "request_body": {
          "templateId": "{{created_template_id}}",
          "addFavorite": true,
          "defaultTemplate": false
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
      {
        "name": "移动模板到另一分类",
        "method": "POST",
        "base_url": "{{RULEBASEURL}}",
        "path": "/template/moveTemplate",
