          "ruleType": "Keyword",
          "isFavorite": false,
          "defaultTemplate": false,
          "frequency": "Weekly",
          "dayOfWeek": 7,
          "hour": 0,
          "automation": [
            {
              "requirements": [
                [
                  {
                    "field": "ROAS",
                    "valueType": "Custom",
                    "id": "requirement_0_0_autotest",
                    "value": "4",
                    "operand": "Greater"
                  }
                ]
              ],
              "dateIndex": {
                "length": 7,
                "index": 1,
                "days": 14
              },
              "action": {
                "cap": 10,
                "percentage": 10,
                "action": "Increase",
                "budgetRate": 100,
                "actionName": "Increase"
              },
              "secondDateIndex": {}
            }
          ]
        },
        "extract_vars": {},
        "expected_response": {
          "code": 200
        }
      },
